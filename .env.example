# Telegram Bot API — заполните своими значениями в .env.local (НЕ коммитить!)
# Токен демо-бота от @BotFather:
TELEGRAM_BOT_TOKEN=
# chat_id владельца, куда падают заявки (узнать у @userinfobot или @getmyid_bot):
TELEGRAM_CHAT_ID=

# Если обе переменные пустые — приложение работает в MOCK-режиме:
# заявка валидируется и логируется в консоль сервера, ответ { ok: true, mock: true }.
