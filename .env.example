# Telegram Bot API — заполните своими значениями в .env.local (НЕ коммитить!)
# Токен демо-бота от @BotFather:
TELEGRAM_BOT_TOKEN=
# chat_id владельца, куда падают заявки (узнать у @userinfobot или @getmyid_bot):
TELEGRAM_CHAT_ID=

# Секрет для проверки Telegram webhook (любая длинная случайная строка).
# Передаётся в setWebhook(secret_token) и сверяется в /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=

# Публичный URL приложения (для кнопки запуска Mini App в /start).
# По умолчанию используется прод-домен.
NEXT_PUBLIC_APP_URL=

# Если TELEGRAM_BOT_TOKEN/CHAT_ID пустые — приложение работает в MOCK-режиме:
# заявка валидируется и логируется в консоль сервера, ответ { ok: true, mock: true }.
